rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{userId}/tasks/{taskId} {
   function owner() { return request.auth != null && request.auth.uid == userId; }
   function valid() {
    let d = request.resource.data;
    return d.keys().hasAll(['id','title','day','comment','done','version'])
      && d.keys().hasOnly(['id','title','day','comment','done','version','time','source_id','label','labels','priority','pending_from_date'])
      && d.id == taskId && d.id is string && d.id.size() > 0 && d.id.size() <= 80
      && d.title is string && d.title.size() > 0 && d.title.size() <= 500
      && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && d.comment is string && d.comment.size() <= 10000
      && d.done is int && d.done in [0,1]
      && d.version is int && d.version >= 1
      && (!d.keys().hasAll(['time']) || (d.time is string && d.time.matches('^[0-9]{1,2}:[0-9]{2}$')))
      && (!d.keys().hasAll(['source_id']) || (d.source_id is string && d.source_id.size() > 0))
      && (!d.keys().hasAll(['label']) || (d.label is string && d.label.size() > 0 && d.label.size() <= 80))
      && (!d.keys().hasAll(['labels']) || (d.labels is list && d.labels.size() <= 10))
      && (!d.keys().hasAll(['priority']) || (d.priority is int && d.priority in [0,1]))
      && (!d.keys().hasAll(['pending_from_date']) || (d.pending_from_date is string && d.pending_from_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
   }
   allow read: if owner();
   allow create: if owner() && valid() && request.resource.data.version == 1;
   allow update: if owner() && (
     (valid() && request.resource.data.version == resource.data.version + 1) ||
     // Allow label-only cleanup changes
     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label','labels','version'])
       && (!request.resource.data.keys().hasAll(['labels']) || (request.resource.data.labels is list && request.resource.data.labels.size() <= 10))
       && (!request.resource.data.keys().hasAll(['label']) || request.resource.data.label is string)
       && (!request.resource.data.keys().hasAll(['version']) || request.resource.data.version is int))
   );
   allow delete: if owner();
  }
  match /users/{userId}/labels/{labelId} {
   function owner() { return request.auth != null && request.auth.uid == userId; }
   function valid() {
    let d = request.resource.data;
    return d.keys().hasAll(['id','name','hasBeenUsed'])
      && d.keys().hasOnly(['id','name','hasBeenUsed','createdAt'])
      && d.id == labelId && d.id is string && d.id.size() > 0 && d.id.size() <= 80
      && d.name is string && d.name.size() > 0 && d.name.size() <= 50
      && d.hasBeenUsed is bool
      && (!d.keys().hasAll(['createdAt']) || (d.createdAt is string && d.createdAt.size() > 0));
   }
   allow read: if owner();
   allow create: if owner() && valid();
   allow update: if owner() && valid();
   allow delete: if owner();
  }
 }
}
